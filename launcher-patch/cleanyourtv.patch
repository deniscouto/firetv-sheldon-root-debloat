+            // A package with no launchable activity at all (e.g. a settings app whose screens are only
+            // reachable by action, never by category.LAUNCHER) still gets a tile when it has a launch_actions
+            // override: the tile's own base intent is synthetic and is never started, since launch() always
+            // replaces it with the launch_actions intent before calling startActivity (#this build's bluetooth fix).
+            for (String pkg : added) {
+                if (!seen.add(pkg) || !launchActions.containsKey(pkg)) continue;
+                try {
+                    ResolveInfo synthetic = new ResolveInfo();
+                    android.content.pm.ActivityInfo info = new android.content.pm.ActivityInfo();
+                    info.applicationInfo = pm.getApplicationInfo(pkg, 0);
+                    info.packageName = pkg;
+                    info.name = ".";
+                    info.exported = true;
+                    synthetic.activityInfo = info;
+                    found.add(synthetic);
+                } catch (PackageManager.NameNotFoundException ignored) { }
+            }
         }
